{
    "python.REPL.enableREPLSmartSend": false,
    "files.watcherExclude": {
        "**/.venv/**": true,
        "**/venv/**": true,
        "**/__pycache__/**": true,
        "**/.pytest_cache/**": true,
        "**/node_modules/**": true
    },
    "workbench.colorCustomizations": {
        "window.titleBarStyle": "custom",
        "activityBar.background": "#082803",
