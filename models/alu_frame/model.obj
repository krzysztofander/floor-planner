# Aluminium Frame - 3D Model for Floor Planner
# Base dimensions: 1.0 m wide x 2.1 m tall x 0.08 m deep
# Four aluminium perimeter bars only — no glass infill.
# Scale via secondary_normalization to match actual length / height / thickness.
# Units: meters  |  X = width, Y = height, Z = depth (wall thickness direction)
#
# Parts:
#   alu_frame_mat  - aluminium perimeter bars

mtllib model.mtl

# ---- Normals ----
vn  0.0  0.0 -1.0
vn  0.0  0.0  1.0
vn -1.0  0.0  0.0
vn  1.0  0.0  0.0
vn  0.0 -1.0  0.0
vn  0.0  1.0  0.0

# ---- UVs (BL, BR, TR, TL) ----
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0

# --- Box 1: Left frame bar   (0.00, 0.00, 0.00) -> (0.03, 2.10, 0.08) ---
v 0.00 0.00 0.00
v 0.03 0.00 0.00
v 0.03 2.10 0.00
v 0.00 2.10 0.00
v 0.00 0.00 0.08
v 0.03 0.00 0.08
v 0.03 2.10 0.08
v 0.00 2.10 0.08

# --- Box 2: Right frame bar  (0.97, 0.00, 0.00) -> (1.00, 2.10, 0.08) ---
v 0.97 0.00 0.00
v 1.00 0.00 0.00
v 1.00 2.10 0.00
v 0.97 2.10 0.00
v 0.97 0.00 0.08
v 1.00 0.00 0.08
v 1.00 2.10 0.08
v 0.97 2.10 0.08

# --- Box 3: Top frame bar    (0.03, 2.07, 0.00) -> (0.97, 2.10, 0.08) ---
v 0.03 2.07 0.00
v 0.97 2.07 0.00
v 0.97 2.10 0.00
v 0.03 2.10 0.00
v 0.03 2.07 0.08
v 0.97 2.07 0.08
v 0.97 2.10 0.08
v 0.03 2.10 0.08

# --- Box 4: Bottom frame bar (0.03, 0.00, 0.00) -> (0.97, 0.03, 0.08) ---
v 0.03 0.00 0.00
v 0.97 0.00 0.00
v 0.97 0.03 0.00
v 0.03 0.03 0.00
v 0.03 0.00 0.08
v 0.97 0.00 0.08
v 0.97 0.03 0.08
v 0.03 0.03 0.08

# ====================================================================
# FACES
# ====================================================================

g frame
usemtl alu_frame_mat

# Box 1 - Left frame bar (base vertex 1)
f  1/1/1  4/4/1  3/3/1  2/2/1
f  5/1/2  6/2/2  7/3/2  8/4/2
f  1/1/3  5/2/3  8/3/3  4/4/3
f  2/1/4  3/2/4  7/3/4  6/4/4
f  1/1/5  2/2/5  6/3/5  5/4/5
f  4/1/6  8/2/6  7/3/6  3/4/6

# Box 2 - Right frame bar (base vertex 9)
f  9/1/1 12/4/1 11/3/1 10/2/1
f 13/1/2 14/2/2 15/3/2 16/4/2
f  9/1/3 13/2/3 16/3/3 12/4/3
f 10/1/4 11/2/4 15/3/4 14/4/4
f  9/1/5 10/2/5 14/3/5 13/4/5
f 12/1/6 16/2/6 15/3/6 11/4/6

# Box 3 - Top frame bar (base vertex 17)
f 17/1/1 20/4/1 19/3/1 18/2/1
f 21/1/2 22/2/2 23/3/2 24/4/2
f 17/1/3 21/2/3 24/3/3 20/4/3
f 18/1/4 19/2/4 23/3/4 22/4/4
f 17/1/5 18/2/5 22/3/5 21/4/5
f 20/1/6 24/2/6 23/3/6 19/4/6

# Box 4 - Bottom frame bar (base vertex 25)
f 25/1/1 28/4/1 27/3/1 26/2/1
f 29/1/2 30/2/2 31/3/2 32/4/2
f 25/1/3 29/2/3 32/3/3 28/4/3
f 26/1/4 27/2/4 31/3/4 30/4/4
f 25/1/5 26/2/5 30/3/5 29/4/5
f 28/1/6 32/2/6 31/3/6 27/4/6
