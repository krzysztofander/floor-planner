# Balcony Door - 3D Model for Floor Planner
# Standard balcony door: 0.9 m wide x 2.1 m tall x 0.12 m deep
# Units: meters
# Coordinate system: X=door width, Y=height (up), Z=wall depth
#
# Parts:
#   frame_mat  - door surround / frame bars (door_frame.jpg texture)
#   door_wood_mat - door wing lower solid panel (door.jpg texture)
#   glass_mat  - door wing upper glass panel (window.jpg texture)

mtllib model.mtl

# ---- Normals (shared across all groups) ----
vn  0.0  0.0 -1.0
vn  0.0  0.0  1.0
vn -1.0  0.0  0.0
vn  1.0  0.0  0.0
vn  0.0 -1.0  0.0
vn  0.0  1.0  0.0

# ---- UVs (shared: BL, BR, TR, TL) ----
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0

# ====================================================================
# VERTICES
# Box layout per group:
#   +0 (x0,y0,z0)  +1 (x1,y0,z0)  +2 (x1,y1,z0)  +3 (x0,y1,z0)   front quad
#   +4 (x0,y0,z1)  +5 (x1,y0,z1)  +6 (x1,y1,z1)  +7 (x0,y1,z1)   back quad
# Face winding (outward CCW per face normal):
#   Front  (-Z): v+0, v+3, v+2, v+1   nv=1
#   Back   (+Z): v+4, v+5, v+6, v+7   nv=2
#   Left   (-X): v+0, v+4, v+7, v+3   nv=3
#   Right  (+X): v+1, v+2, v+6, v+5   nv=4
#   Bottom (-Y): v+0, v+1, v+5, v+4   nv=5
#   Top    (+Y): v+3, v+7, v+6, v+2   nv=6
# ====================================================================

# --- Box 1: Left frame bar  (0.00, 0.00, 0.00) -> (0.06, 2.10, 0.12) ---
v 0.00 0.00 0.00
v 0.06 0.00 0.00
v 0.06 2.10 0.00
v 0.00 2.10 0.00
v 0.00 0.00 0.12
v 0.06 0.00 0.12
v 0.06 2.10 0.12
v 0.00 2.10 0.12

# --- Box 2: Right frame bar (0.84, 0.00, 0.00) -> (0.90, 2.10, 0.12) ---
v 0.84 0.00 0.00
v 0.90 0.00 0.00
v 0.90 2.10 0.00
v 0.84 2.10 0.00
v 0.84 0.00 0.12
v 0.90 0.00 0.12
v 0.90 2.10 0.12
v 0.84 2.10 0.12

# --- Box 3: Top frame bar  (0.06, 2.04, 0.00) -> (0.84, 2.10, 0.12) ---
v 0.06 2.04 0.00
v 0.84 2.04 0.00
v 0.84 2.10 0.00
v 0.06 2.10 0.00
v 0.06 2.04 0.12
v 0.84 2.04 0.12
v 0.84 2.10 0.12
v 0.06 2.10 0.12

# --- Box 4: Bottom sill    (0.06, 0.00, 0.00) -> (0.84, 0.04, 0.12) ---
v 0.06 0.00 0.00
v 0.84 0.00 0.00
v 0.84 0.04 0.00
v 0.06 0.04 0.00
v 0.06 0.00 0.12
v 0.84 0.00 0.12
v 0.84 0.04 0.12
v 0.06 0.04 0.12

# --- Box 5: Door wing - lower wood panel (0.063, 0.043, 0.038) -> (0.837, 0.720, 0.082) ---
v 0.063 0.043 0.038
v 0.837 0.043 0.038
v 0.837 0.720 0.038
v 0.063 0.720 0.038
v 0.063 0.043 0.082
v 0.837 0.043 0.082
v 0.837 0.720 0.082
v 0.063 0.720 0.082

# --- Box 6: Door wing - glass panel (0.063, 0.720, 0.038) -> (0.837, 2.037, 0.082) ---
v 0.063 0.720 0.038
v 0.837 0.720 0.038
v 0.837 2.037 0.038
v 0.063 2.037 0.038
v 0.063 0.720 0.082
v 0.837 0.720 0.082
v 0.837 2.037 0.082
v 0.063 2.037 0.082

# ====================================================================
# FACES
# ====================================================================

g frame
usemtl frame_mat

# Box 1 - Left frame bar (base vertex 1)
f  1/1/1  4/4/1  3/3/1  2/2/1
f  5/1/2  6/2/2  7/3/2  8/4/2
f  1/1/3  5/2/3  8/3/3  4/4/3
f  2/1/4  3/2/4  7/3/4  6/4/4
f  1/1/5  2/2/5  6/3/5  5/4/5
f  4/1/6  8/2/6  7/3/6  3/4/6

# Box 2 - Right frame bar (base vertex 9)
f  9/1/1 12/4/1 11/3/1 10/2/1
f 13/1/2 14/2/2 15/3/2 16/4/2
f  9/1/3 13/2/3 16/3/3 12/4/3
f 10/1/4 11/2/4 15/3/4 14/4/4
f  9/1/5 10/2/5 14/3/5 13/4/5
f 12/1/6 16/2/6 15/3/6 11/4/6

# Box 3 - Top frame bar (base vertex 17)
f 17/1/1 20/4/1 19/3/1 18/2/1
f 21/1/2 22/2/2 23/3/2 24/4/2
f 17/1/3 21/2/3 24/3/3 20/4/3
f 18/1/4 19/2/4 23/3/4 22/4/4
f 17/1/5 18/2/5 22/3/5 21/4/5
f 20/1/6 24/2/6 23/3/6 19/4/6

# Box 4 - Bottom sill (base vertex 25)
f 25/1/1 28/4/1 27/3/1 26/2/1
f 29/1/2 30/2/2 31/3/2 32/4/2
f 25/1/3 29/2/3 32/3/3 28/4/3
f 26/1/4 27/2/4 31/3/4 30/4/4
f 25/1/5 26/2/5 30/3/5 29/4/5
f 28/1/6 32/2/6 31/3/6 27/4/6

g door_wood
usemtl door_wood_mat

# Box 5 - Door wing lower wood panel (base vertex 33)
f 33/1/1 36/4/1 35/3/1 34/2/1
f 37/1/2 38/2/2 39/3/2 40/4/2
f 33/1/3 37/2/3 40/3/3 36/4/3
f 34/1/4 35/2/4 39/3/4 38/4/4
f 33/1/5 34/2/5 38/3/5 37/4/5
f 36/1/6 40/2/6 39/3/6 35/4/6

g door_glass
usemtl glass_mat

# Box 6 - Door wing glass panel (base vertex 41)
f 41/1/1 44/4/1 43/3/1 42/2/1
f 45/1/2 46/2/2 47/3/2 48/4/2
f 41/1/3 45/2/3 48/3/3 44/4/3
f 42/1/4 43/2/4 47/3/4 46/4/4
f 41/1/5 42/2/5 46/3/5 45/4/5
f 44/1/6 48/2/6 47/3/6 43/4/6
